# Copy this file to .env and fill in the values. Never commit .env.
# Wrap a value in single quotes if it contains spaces or a # character.

# A long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key

# True only on your own machine. If this line is missing, DEBUG is off.
DJANGO_DEBUG=True

# Comma-separated host names this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. The role and database must exist before you start.
DB_NAME=healthcare_db
DB_USER=healthcare_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432
